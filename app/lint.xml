<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint runs as a build gate (abortOnError), so every finding that stays here is a deliberate
  decision rather than an oversight. Each ignore below says why.
-->
<lint>
    <!-- compileSdk/targetSdk are pinned to 34: the only device this app ships to is an
         Android 9 (API 28) Mi Box 4, and a newer target buys nothing there. -->
    <issue id="OldTargetApi" severity="ignore" />

    <!-- "A newer version is available" notices. Upgrades are deliberate, not automatic. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Locking every activity to landscape is the point: this is a ten-foot TV app driven
         by a remote, and Android TV itself never rotates. -->
    <issue id="DiscouragedApi" severity="ignore">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>

    <!-- The banner is a 320x180 TV launcher banner, not an icon; the 200x200 advice for
         vector icons does not apply. -->
    <issue id="VectorRaster" severity="ignore">
        <ignore path="src/main/res/drawable/app_banner.xml" />
    </issue>

    <!-- The dialog's FrameLayout is what centres the card on screen; it is not redundant. -->
    <issue id="UselessParent" severity="ignore">
        <ignore path="src/main/res/layout/dialog_tv.xml" />
    </issue>

    <!-- A dialog's content view has no parent to inflate against. -->
    <issue id="InflateParams" severity="ignore">
        <ignore path="src/main/java/tv/jacred/client/TvDialog.java" />
    </issue>

    <!-- Solid, clearly bordered buttons are deliberate: a borderless button has no visible
         focus target, and focus is the only way around this app. -->
    <issue id="ButtonStyle" severity="ignore" />

    <!-- Counts in status lines read "3 titles"/"1 titles". Wiring up plurals would change
         wording the app already ships with, and the app is English-only. -->
    <issue id="PluralsCandidate" severity="ignore" />
</lint>
