<?xml version="1.0" encoding="utf-8"?>
<!--
  The cue a television set trained everyone to expect: the focused card comes forward.
  Kept to 4% because a grid clips its children, so a larger lift is cropped rather than
  seen. Containers using this need clipChildren and clipToPadding off.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleX"
                android:valueTo="1.04"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleY"
                android:valueTo="1.04"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
