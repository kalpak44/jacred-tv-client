<?xml version="1.0" encoding="utf-8"?>
<!--
  The scales every screen measures against. A value typed straight into a layout is a
  value nothing else can match, which is how a ten-foot UI ends up with six near-identical
  paddings and no rhythm.
-->
<resources>

    <!-- Overscan safe area. A television crops the edges of its input, and a control
         closer than this to the edge can be off the panel on some sets. -->
    <dimen name="screen_margin_h">48dp</dimen>
    <dimen name="screen_margin_top">28dp</dimen>
    <dimen name="screen_margin_bottom">20dp</dimen>

    <!-- Spacing scale. Steps are far enough apart to read as deliberate at distance. -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- Type scale. The floor is 14sp: anything smaller is unreadable from a sofa, which
         is the only distance this app is used from. -->
    <dimen name="text_display">32sp</dimen>
    <dimen name="text_title">24sp</dimen>
    <dimen name="text_subtitle">18sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_caption">14sp</dimen>

    <!-- Corner radii. Two values only: pills for chips, one radius for everything else. -->
    <dimen name="radius">12dp</dimen>
    <dimen name="radius_pill">22dp</dimen>

    <!-- Focus ring. One width everywhere, so focus reads as the same thing on every
         control rather than as a property of the control it happens to be on. -->
    <dimen name="focus_ring">3dp</dimen>
    <dimen name="outline">2dp</dimen>

    <!-- Control heights. A D-pad target wants bulk; these are the only three sizes. -->
    <dimen name="control_height">56dp</dimen>
    <dimen name="control_height_l">64dp</dimen>
    <dimen name="chip_height">44dp</dimen>

</resources>
