<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_top"
    android:paddingRight="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/mint"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/server_chip"
            style="@style/HeaderChip"
            android:layout_marginStart="@dimen/space_xl" />

        <TextView
            android:id="@+id/version_chip"
            style="@style/HeaderChip"
            android:layout_marginStart="@dimen/space_s" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/settings_button"
            style="@style/GhostButton"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="@dimen/space_m"
            android:nextFocusDown="@id/query"
            android:text="@string/settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/query"
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:nextFocusUp="@id/settings_button"
            android:textColorHighlight="@color/selection" />

        <Button
            android:id="@+id/search_button"
            style="@style/PrimaryButton"
            android:layout_width="150dp"
            android:layout_marginStart="@dimen/space_l"
            android:nextFocusUp="@id/settings_button"
            android:text="@string/search" />
    </LinearLayout>

    <Button
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/update_banner"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:nextFocusDown="@id/query"
        android:nextFocusUp="@id/settings_button"
        android:paddingLeft="@dimen/space_xl"
        android:paddingRight="@dimen/space_xl"
        android:textAllCaps="false"
        android:textColor="@color/update_text"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        style="@style/StatusText"
        android:layout_marginTop="@dimen/space_m" />

    <LinearLayout
        android:id="@+id/history_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/SectionLabel"
            android:text="@string/recent" />

        <!-- clipChildren off on the scroller and the row alike: the focused card scales
             up, and is otherwise cropped by whichever of them is tighter. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/history_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/space_s"
        android:text="@string/empty_state"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_subtitle"
        android:visibility="gone" />

    <GridView
        android:id="@+id/movies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:columnWidth="160dp"
        android:drawSelectorOnTop="true"
        android:horizontalSpacing="@dimen/space_l"
        android:listSelector="@drawable/card_focus"
        android:numColumns="auto_fit"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="@dimen/space_l" />

</LinearLayout>
