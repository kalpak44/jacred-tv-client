<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="48dp"
    android:paddingTop="28dp"
    android:paddingRight="48dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/mint"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/server_chip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="22dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/version_chip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/settings_button"
            style="@style/GhostButton"
            android:nextFocusDown="@id/query"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="10dp"
            android:text="@string/settings" />
    </LinearLayout>

    <Button
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/update_banner"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_button"
        android:nextFocusDown="@id/query"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:textAllCaps="false"
        android:textColor="@color/update_text"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/query"
            android:nextFocusUp="@id/settings_button"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:background="@drawable/field_background"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textColor="@android:color/white"
            android:textColorHighlight="@color/selection"
            android:textColorHint="@color/text_muted"
            android:textSize="19sp" />

        <Button
            android:id="@+id/search_button"
            android:nextFocusUp="@id/settings_button"
            android:layout_width="150dp"
            android:layout_height="62dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_background"
            android:fontFamily="sans-serif-medium"
            android:text="@string/search"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/history_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/recent"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/history_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="@string/empty_state"
        android:textColor="@color/text_muted"
        android:textSize="17sp"
        android:visibility="gone" />

    <GridView
        android:id="@+id/movies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:columnWidth="168dp"
        android:horizontalSpacing="18dp"
        android:numColumns="auto_fit"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="18dp" />

</LinearLayout>
