<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_top"
    android:paddingRight="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_bottom">

    <ImageView
        android:id="@+id/detail_poster"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:background="@drawable/poster_placeholder"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_xxl"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_title"
            style="@style/ScreenTitle"
            android:layout_width="match_parent"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/detail_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mint"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/detail_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/space_xs"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/detail_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/mint"
            android:textSize="@dimen/text_label" />

        <HorizontalScrollView
            android:id="@+id/action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/watch_button"
                    style="@style/PrimaryButton"
                    android:layout_marginEnd="@dimen/space_m"
                    android:text="@string/watch"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/keep_button"
                    style="@style/GhostButton"
                    android:layout_height="@dimen/control_height_l"
                    android:layout_marginEnd="@dimen/space_m"
                    android:text="@string/keep_on_server"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/magnet_button"
                    style="@style/GhostButton"
                    android:layout_height="@dimen/control_height_l"
                    android:text="@string/open_magnet" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Directly above the list it describes. It used to sit over the action row,
             where it read as advice about the buttons. -->
        <TextView
            android:id="@+id/detail_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_s"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/row_selector"
            android:scrollbars="none" />
    </LinearLayout>

</LinearLayout>
