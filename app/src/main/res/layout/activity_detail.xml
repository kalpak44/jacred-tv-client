<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="48dp"
    android:paddingTop="32dp"
    android:paddingRight="48dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/detail_poster"
        android:layout_width="168dp"
        android:layout_height="252dp"
        android:background="@drawable/poster_placeholder"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="27sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mint"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detail_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/mint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detail_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/watch_button"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/button_background"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:text="@string/watch"
                android:textAllCaps="false"
                android:textColor="@color/button_text"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/playlist_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/play_all"
                android:visibility="gone" />

            <Button
                android:id="@+id/watched_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/watched_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/keep_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/keep_on_server"
                android:visibility="gone" />

            <Button
                android:id="@+id/magnet_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/open_magnet" />

            <Button
                android:id="@+id/remove_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/remove_from_server" />

            <Button
                android:id="@+id/detail_settings_button"
                style="@style/GhostButton"
                android:layout_marginEnd="14dp"
                android:text="@string/settings" />
        </LinearLayout>
        </HorizontalScrollView>

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/row_selector"
            android:scrollbars="none" />
    </LinearLayout>

</LinearLayout>
