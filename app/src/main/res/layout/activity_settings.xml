<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="48dp"
    android:paddingTop="32dp"
    android:paddingRight="48dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings"
            android:textColor="@android:color/white"
            android:textSize="32sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_api" />

        <EditText
            android:id="@+id/api_field"
            style="@style/Field"
            android:hint="@string/settings_api_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_torrserver" />

        <EditText
            android:id="@+id/server_field"
            style="@style/Field"
            android:hint="@string/settings_torrserver_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_user" />

                <EditText
                    android:id="@+id/user_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_pass" />

                <EditText
                    android:id="@+id/pass_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_tmdb_key" />

        <EditText
            android:id="@+id/tmdb_key_field"
            style="@style/Field"
            android:hint="@string/settings_tmdb_key_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_tmdb_api" />

                <EditText
                    android:id="@+id/tmdb_api_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_tmdb_images" />

                <EditText
                    android:id="@+id/tmdb_image_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/import_button"
                style="@style/SecondaryButton"
                android:text="@string/import_from_server" />

            <Button
                android:id="@+id/mirror_button"
                style="@style/SecondaryButton"
                android:layout_marginStart="14dp"
                android:text="@string/use_image_mirror" />

            <Button
                android:id="@+id/clear_history_button"
                style="@style/SecondaryButton"
                android:layout_marginStart="14dp"
                android:text="@string/clear_history" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_player" />

        <Button
            android:id="@+id/player_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_background"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:background="@drawable/button_background"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="@string/test_connection"
                android:textColor="@color/button_text"
                android:textSize="17sp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/button_background"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="@string/save"
                android:textColor="@color/button_text"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
