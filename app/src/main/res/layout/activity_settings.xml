<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_top"
    android:paddingRight="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/version_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_api" />

        <EditText
            android:id="@+id/api_field"
            style="@style/Field"
            android:hint="@string/settings_api_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_torrserver" />

        <EditText
            android:id="@+id/server_field"
            style="@style/Field"
            android:hint="@string/settings_torrserver_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_user" />

                <EditText
                    android:id="@+id/user_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_pass" />

                <EditText
                    android:id="@+id/pass_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_tmdb_key" />

        <EditText
            android:id="@+id/tmdb_key_field"
            style="@style/Field"
            android:hint="@string/settings_tmdb_key_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_tmdb_api" />

                <EditText
                    android:id="@+id/tmdb_api_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/settings_tmdb_images" />

                <EditText
                    android:id="@+id/tmdb_image_field"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <Button
                android:id="@+id/import_button"
                style="@style/SecondaryButton"
                android:text="@string/import_from_server" />

            <Button
                android:id="@+id/mirror_button"
                style="@style/SecondaryButton"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/use_image_mirror" />

            <Button
                android:id="@+id/clear_history_button"
                style="@style/SecondaryButton"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/clear_history" />

            <Button
                android:id="@+id/update_button"
                style="@style/SecondaryButton"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/check_updates" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_language" />

        <Button
            android:id="@+id/language_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_l"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/field_background"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_xl"
            android:paddingRight="@dimen/space_xl"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_player" />

        <Button
            android:id="@+id/player_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_l"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/field_background"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_xl"
            android:paddingRight="@dimen/space_xl"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_subtitle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test_button"
                style="@style/SecondaryButton"
                android:layout_height="@dimen/control_height_l"
                android:text="@string/test_connection" />

            <Button
                android:id="@+id/save_button"
                style="@style/PrimaryButton"
                android:layout_marginStart="@dimen/space_l"
                android:text="@string/save" />
        </LinearLayout>

        <TextView
            android:id="@+id/test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>
</ScrollView>
