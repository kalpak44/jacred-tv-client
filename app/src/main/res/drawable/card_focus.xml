<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawn over the card, so the ring covers the resting outline instead of fighting it.
  Ring only, no fill: on top of the child a fill would cover the poster.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/mint" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
