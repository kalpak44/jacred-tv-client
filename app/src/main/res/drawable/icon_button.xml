<?xml version="1.0" encoding="utf-8"?>
<!--
  A round icon-only control. The same focus rule as every other compact control — accent
  fill — and the icon's own tint selector darkens it to match.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/mint" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/mint" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/outline" android:color="@color/outline_colour" />
        </shape>
    </item>
</selector>
