<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      The app installs its own updates from its GitHub releases. Without this the
      package installer refuses the session before the user is ever asked.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Guards the install-status broadcast the package installer sends back. Signature
      level, so only this app can deliver one: without it the receiver is reachable by
      any app on the device, and what it carries is an intent this app then launches.
    -->
    <permission
        android:name="tv.jacred.client.permission.INSTALL_STATUS"
        android:protectionLevel="signature" />
    <uses-permission android:name="tv.jacred.client.permission.INSTALL_STATUS" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Package visibility (Android 11 and newer). The app asks the system which installed apps
      can open a video stream, and hands magnets to whatever claims them; without these
      declarations those queries come back empty on a modern device and no player is offered.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="magnet" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_tv"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HelloTv"
        android:usesCleartextTraffic="true">
        <!--
          Cleartext is required, not an oversight: TorrServer is a box on the same LAN
          reached over plain http at an address the user types in Settings, and both the
          stream and the player handoff use that address.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReleasesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>

</manifest>
